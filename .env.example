# ============================================================================
# Velora Civic AI — Environment Variables
# Copy this file to `.env.local` for local development, and add the same keys
# to your Vercel Project Settings → Environment Variables for deployment.
# ============================================================================

# ---------------------------------------------------------------------------
# Google Maps (CLIENT-SIDE) — required for the interactive India map.
# Create at: https://console.cloud.google.com/  (enable "Maps JavaScript API")
# Restrict the key to your Vercel domain (HTTP referrers).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a vector Map ID for advanced styling (not required in Phase 1).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Maps (SERVER-SIDE) — used by U2 Context Intelligence for Geocoding +
# Places (reverse geocoding, nearby landmarks, context-aware severity).
# Create a SEPARATE key WITHOUT HTTP-referrer restriction (restrict by API
# instead: Geocoding API + Places API). Falls back to the public key if unset.
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# Gemini / Google AI Studio (SERVER-SIDE) — config only in Phase 1.
# Create at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Firebase CLIENT config (CLIENT-SIDE) — safe to expose to the browser.
# Project Settings → General → Your apps → Web app config.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase ADMIN config (SERVER-SIDE) — keep secret. Never expose to client.
# Project Settings → Service accounts → Generate new private key.
# Paste either the raw JSON or its base64 encoding (base64 recommended for
# single-line storage in Vercel):
#   cat serviceAccount.json | base64
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# Storage bucket name for the Admin SDK (e.g. your-project-id.appspot.com).
FIREBASE_STORAGE_BUCKET=
